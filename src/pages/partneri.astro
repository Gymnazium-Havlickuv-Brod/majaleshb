---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import { AKCE, KONTAKT } from '../data/akce';
import { UROVNE, DALSI, PROC, POSTUP } from '../data/partneri';
import { podleRole } from '../data/fotky';
import PartneriLoga from '../components/PartneriLoga.astro';

const foto = podleRole('partneri'); // úvod pro partnery: fotka bez reklam minulých partnerů
// odkaz mailto: s předmětem a připraveným textem (okno NapsatEmail z něj udělá i Gmail / Outlook)
const NL = String.fromCharCode(13, 10); // konec řádku v těle e-mailu (CRLF)
const PODPIS = ['', '', 'Firma:', 'Kontaktní osoba:', 'Telefon:', '', 'S pozdravem'].join(NL);
const mail = (predmet: string, uvod = `rádi bychom se domluvili na partnerství Majálesu ${AKCE.rok}.`) =>
  `mailto:${KONTAKT.email}?subject=${encodeURIComponent(predmet)}&body=${encodeURIComponent(['Dobrý den,', '', uvod].join(NL) + PODPIS)}`;
const zajem = (u: (typeof UROVNE)[number]) =>
  u.id === 'dar'
    ? `rádi bychom Majáles ${AKCE.rok} podpořili věcným darem (jídlo nebo ceny do hry o ceny).`
    : `máme zájem o partnerství Majálesu ${AKCE.rok}, úroveň ${u.nazev} (${u.castka}).`;
---

<Base
  title={`Partneři · Majáles ${AKCE.rok} Havlíčkův Brod`}
  description={`Podpořte studentský Majáles ${AKCE.datum} na Havlíčkově náměstí. Úrovně partnerství od 5 000 Kč, věcný dar i individuální nabídka.`}
>
  <!-- úvod -->
  <section class="na-modre overflow-hidden">
    <div class="obal pt-12 pb-16 sm:pt-16 sm:pb-24 grid gap-12 lg:grid-cols-[1.2fr_1fr] lg:items-center">
      <div>
        <h1 class="display text-[clamp(3.5rem,12vw,8.5rem)]">Buďte<br />u toho</h1>
        <p class="mt-6 max-w-xl text-lg leading-relaxed">
          {AKCE.den} {AKCE.datum}, {AKCE.misto}. Majáles staví studenti Gymnázia a SPŠ stavební. S vaší podporou
          z něj uděláme akci, na kterou bude celý Brod vzpomínat.
        </p>
        <div class="mt-8 flex flex-wrap gap-3">
          <a href="#urovne" class="tlacitko tlacitko-plne">Úrovně partnerství</a>
          <a href={mail(`Partnerství Majáles ${AKCE.rok}`)} class="tlacitko">Napište nám</a>
        </div>
      </div>
      <div class="relative">
        <Image src={foto.img} alt={foto.alt} widths={[480, 800, 1200]} sizes="(min-width: 1024px) 42vw, 92vw" loading="eager" class="w-full aspect-[4/3] object-cover rounded-[2rem] rotate-[1.5deg] ring-4 ring-hot" />
      </div>
    </div>
  </section>

  <!-- proč -->
  <section class="sekce" aria-labelledby="proc-nadpis">
    <div class="obal">
      <h2 id="proc-nadpis" class="display text-[clamp(2.5rem,7vw,4.5rem)]">Proč Majáles</h2>
      <ul class="mt-10 grid gap-8 md:grid-cols-3">
        {
          PROC.map((p) => (
            <li class="border-t-2 border-hot pt-5">
              <h3 class="display text-3xl">{p.nadpis}</h3>
              <p class="mt-3 leading-relaxed">{p.text}</p>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <!-- úrovně -->
  <section id="urovne" class="sekce pt-0 scroll-mt-16" aria-labelledby="urovne-nadpis">
    <div class="obal">
      <div class="flex flex-wrap items-end justify-between gap-4">
        <h2 id="urovne-nadpis" class="display text-[clamp(2.5rem,7vw,4.5rem)]">Úrovně partnerství</h2>
        <p class="max-w-sm">Částky jsou orientační. Co přesně dostanete, doladíme spolu.</p>
      </div>

      <ul class="mt-10 grid gap-5 sm:grid-cols-2 xl:grid-cols-4">
        {
          UROVNE.map((u) => (
            <li
              class:list={[
                'relative flex flex-col rounded-[1.75rem] p-6 sm:p-7',
                u.zvyraznit ? 'na-modre karta xl:-my-4 xl:py-10' : 'karta',
              ]}
            >
              {u.stitek && (
                <span class="stitek absolute -top-3 right-5 px-3 py-1 text-xs uppercase tracking-wider">
                  {u.stitek}
                </span>
              )}
              <h3 class="kicker">{u.nazev}</h3>
              <p class="display mt-3 text-[2.6rem] leading-none">{u.castka}</p>
              <p class="mt-3 text-sm">{u.podtitul}</p>
              <ul class="mt-6 space-y-3 border-t-2 border-hot pt-5 text-[0.95rem] flex-1">
                {u.vyhody.map((v) => (
                  <li class="flex gap-3">
                    <span class="mt-[0.45rem] size-2 shrink-0 rounded-full bg-hot" aria-hidden="true" />
                    <span>{v}</span>
                  </li>
                ))}
              </ul>
              <a
                href={mail(`Partnerství Majáles ${AKCE.rok}: ${u.nazev}`, zajem(u))}
                class:list={['tlacitko mt-8 justify-center', u.zvyraznit && 'tlacitko-plne']}
              >
                Mám zájem
              </a>
            </li>
          ))
        }
      </ul>

      <ul class="mt-8 grid gap-5">
        {
          DALSI.map((d) => (
            <li class="karta rounded-[1.75rem] p-6 sm:p-8 flex flex-col">
              <h3 class="display text-4xl">{d.podtitul}</h3>
              <p class="mt-3 leading-relaxed flex-1">{d.text}</p>
              <a href={mail(`Majáles ${AKCE.rok}: ${d.nazev}`, `rádi bychom se domluvili na spolupráci s Majálesem ${AKCE.rok} na míru. Představujeme si: `)} class="odkaz mt-5 self-start">
                Ozvat se <span class="text-hot" aria-hidden="true">→</span>
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <!-- postup -->
  <section class="sekce pt-0" aria-labelledby="postup-nadpis">
    <div class="obal grid gap-12 lg:grid-cols-[1fr_1.3fr]">
      <div>
        <h2 id="postup-nadpis" class="display text-[clamp(2.5rem,7vw,4.5rem)]">Jak to<br />probíhá</h2>
        <p class="mt-6 max-w-sm">Napište na <a class="odkaz" href={mail(`Partnerství Majáles ${AKCE.rok}`)}>{KONTAKT.email}</a>. Ozveme se do pár dní.</p>
      </div>
      <ol class="grid gap-4 sm:grid-cols-2">
        {
          POSTUP.map((k, i) => (
            <li class="rounded-[1.5rem] na-modre p-6">
              <span class="display text-5xl leading-none">{i + 1}</span>
              <p class="mt-3">{k}</p>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <!-- kdo už podporuje -->
  <section class="sekce pt-0" aria-label="Partneři Majálesu">
    <div class="obal">
      <PartneriLoga nadpis="Už nás podporují" nadpisPrazdne="Místa pro partnery" odkazNaNabidku={false} />
    </div>
  </section>
</Base>
