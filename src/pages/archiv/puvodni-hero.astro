---
import { Image } from 'astro:assets';
import Base from '../../layouts/Base.astro';
import HeroPlakat from '../../components/archiv/HeroPlakat.astro';
import Galerie from '../../components/Galerie.astro';
import PartneriLoga from '../../components/PartneriLoga.astro';
import Kvet from '../../components/Kvet.astro';
import PrubehDne from '../../components/PrubehDne.astro';
import { AKCE, PAS, PROGRAM, LINEUP } from '../../data/akce';
import { podleRole } from '../../data/fotky';

const oMajalesu = podleRole('o-majalesu');
const namesti = podleRole('o-majalesu-2');
const program = PROGRAM.map((p) => ({ ...p, f: podleRole(`program:${p.foto}`) }));

const schema = {
  '@context': 'https://schema.org',
  '@type': 'Festival',
  name: AKCE.nazev,
  startDate: AKCE.datumIso,
  endDate: AKCE.datumIso,
  eventStatus: 'https://schema.org/EventScheduled',
  eventAttendanceMode: 'https://schema.org/OfflineEventAttendanceMode',
  location: {
    '@type': 'Place',
    name: AKCE.misto,
    address: { '@type': 'PostalAddress', addressLocality: AKCE.mesto, addressCountry: 'CZ' },
  },
  organizer: AKCE.skoly.map((name) => ({ '@type': 'EducationalOrganization', name })),
  url: 'https://majaleshb.cz/',
};
---

<!-- ARCHIV: úvodní stránka s původní plakátovou hero sekcí (před 3D). Neindexuje se, není v sitemapě. -->
<Base
  noindex
  title={`Archiv: původní hero · Majáles ${AKCE.rok}`}
  description={`Studentský Majáles ${AKCE.mesto}: ${AKCE.den} ${AKCE.datum} na Havlíčkově náměstí. Kapely, sport, král a královna, zóny gymplu a stavebky.`}
>
  <script type="application/ld+json" set:html={JSON.stringify(schema)} />

  <HeroPlakat />

  <!-- běžící pás -->
  <div class="na-modre overflow-hidden py-4" aria-hidden="true">
    <div class="pas flex w-max gap-8 whitespace-nowrap display text-3xl sm:text-4xl">
      {[0, 1].map(() => PAS.concat(PAS).map((t) => <span class="flex items-center gap-8">{t}<Kvet class="size-[0.8em] shrink-0" /></span>))}
    </div>
  </div>

  <!-- O Majálesu -->
  <section id="o-majalesu" class="sekce" aria-labelledby="o-nadpis">
    <div class="obal grid gap-12 lg:grid-cols-2 lg:items-center">
      <div>
        <h2 id="o-nadpis" class="display text-[clamp(2.8rem,8vw,5.5rem)]">Oslava jara<br />a mládí</h2>
        <div class="mt-6 space-y-4 text-lg leading-relaxed max-w-xl">
          <p>
            Majáles sahá až ke středověkým univerzitám. V Havlíčkově Brodě ho přes dvacet let pořádalo gymnázium,
            od roku 2026 ho připravuje společně se stavební průmyslovkou.
          </p>
          <p>
            Na jeden den patří Havlíčkovo náměstí studentům. Celý program vymýšlí a staví studenti obou škol {AKCE.spoluprace}.
          </p>
        </div>
      </div>
      <div class="relative">
        <Image src={oMajalesu.img} alt={oMajalesu.alt} widths={[480, 800, 1200]} sizes="(min-width: 1024px) 46vw, 92vw" class="w-full aspect-[4/3] object-cover rounded-[2rem]" />
        <Image
          src={namesti.img}
          alt={namesti.alt}
          widths={[300, 500]}
          sizes="(min-width: 1024px) 18vw, 40vw"
          class="absolute -top-12 -right-3 sm:-right-8 w-[36%] aspect-square object-cover rounded-[1.5rem] ring-8 ring-bila rotate-3"
        />
      </div>
    </div>
  </section>

  <!-- Program -->
  <section id="program" class="sekce pt-0 scroll-mt-16" aria-labelledby="program-nadpis">
    <div class="obal">
      <div class="flex flex-wrap items-end justify-between gap-4">
        <div>
          <h2 id="program-nadpis" class="display text-[clamp(2.8rem,8vw,5.5rem)]">Co tě čeká</h2>
        </div>
        <p class="max-w-sm">Program dolaďujeme se studenty. Přesný harmonogram zveřejníme na jaře.</p>
      </div>

      <ul class="mt-12 grid gap-x-6 gap-y-12 sm:grid-cols-2 lg:grid-cols-3">
        {
          program.map((p, i) => (
            <li>
              <div class="overflow-hidden rounded-[1.5rem]">
                <Image src={p.f.img} alt={p.f.alt} widths={[400, 640, 900]} sizes="(min-width: 1024px) 30vw, (min-width: 640px) 46vw, 92vw" class="w-full aspect-[4/3] object-cover" />
              </div>
              <p class="mt-5 text-sm font-bold tabular-nums">{String(i + 1).padStart(2, '0')}</p>
              <h3 class="display text-3xl sm:text-4xl mt-1">{p.nazev}</h3>
              <p class="mt-3 leading-relaxed">{p.text}</p>
            </li>
          ))
        }
      </ul>

      <!-- průběh dne -->
      <PrubehDne />
    </div>
  </section>

  <!-- Line-up -->
  <section id="line-up" class="sekce na-modre" aria-labelledby="lineup-nadpis">
    <div class="obal">
      <div class="flex flex-wrap items-end justify-between gap-4">
        <div>
          <h2 id="lineup-nadpis" class="display text-[clamp(2.8rem,8vw,5.5rem)]">Šest kapel, jména<br />prozradíme brzy</h2>
        </div>
        <p class="max-w-sm">Domlouváme kapely na hlavní stage a odhalovat je budeme postupně, tak nás sleduj.</p>
      </div>
      <ul class="mt-12 grid grid-cols-2 lg:grid-cols-3 gap-3 sm:gap-5">
        {
          LINEUP.map((k) => (
            <li class="relative aspect-[4/3] lg:aspect-[16/9] rounded-[1.5rem] border-2 border-dashed border-hot grid place-items-center">
              <span class="absolute left-4 top-3 text-sm font-bold tabular-nums">{k.cislo}</span>
              <span class="display text-[clamp(4.5rem,14vw,8rem)] leading-none">{k.jmeno}</span>
              <span class="absolute bottom-3 left-4 right-4 kicker !text-[0.65rem]">Jméno odhalíme brzy</span>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <!-- Partneři (loga) -->
  <section id="partneri" class="sekce" aria-label="Partneři Majálesu">
    <div class="obal">
      <PartneriLoga />
    </div>
  </section>

  <!-- Galerie -->
  <section id="galerie" class="sekce predel" aria-labelledby="galerie-nadpis">
    <div class="obal">
      <h2 id="galerie-nadpis" class="display text-[clamp(2.8rem,8vw,5.5rem)]">Takhle to vypadalo</h2>
      <p class="mt-4 max-w-xl">Letos to bude ještě větší.</p>
      <div class="mt-10">
        <Galerie />
      </div>
    </div>
  </section>

  <!-- Partneři CTA -->
  <section class="sekce predel" aria-labelledby="cta-nadpis">
    <div class="obal">
      <div class="na-modre rounded-[2rem] p-8 sm:p-12 lg:p-16 grid gap-8 lg:grid-cols-[1.4fr_1fr] lg:items-end">
      <div>
        <h2 id="cta-nadpis" class="display text-[clamp(2.8rem,8vw,5.5rem)]">Podpořte<br />Majáles {AKCE.rok}</h2>
      </div>
      <div>
        <p class="text-lg leading-relaxed">
          Od 5 000 Kč, nebo darem: jídlem či cenami do hry o ceny. Vyberte si úroveň, která vám sedí.
        </p>
        <a href="/partneri/" class="tlacitko tlacitko-plne mt-6">Úrovně partnerství →</a>
      </div>
      </div>
    </div>
  </section>
</Base>
