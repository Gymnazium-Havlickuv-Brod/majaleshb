---
// ARCHIV: původní plakátová hero sekce (do 15. 11. 2026 na hlavní stránce). Náhled: /archiv/puvodni-hero/
import { Image } from 'astro:assets';
import { AKCE } from '../../data/akce';
import { HERO } from '../../data/fotky';
import Odpocet from '../Odpocet.astro';
const [hlavni, druha, treti] = HERO;
---

<section class="relative bg-modra text-ruzova overflow-hidden" aria-labelledby="hero-nadpis">
  <div class="obal pt-6 sm:pt-10 pb-16 sm:pb-24 @container">
    <div class="kicker flex justify-between gap-4">
      <span>{AKCE.skolyKratce}</span>
      <span>{AKCE.rok}</span>
    </div>

    <h1 id="hero-nadpis" class="display mt-8 sm:mt-12 select-none">
      <span class="sr-only">Majáles {AKCE.rok}</span>
      <span aria-hidden="true" class="block md:hidden text-[53cqi] leading-[0.84] -ml-[0.02em]">Maj<br />áles</span>
      <span aria-hidden="true" class="hidden md:block text-[29cqi] leading-[0.84] -ml-[0.02em] whitespace-nowrap">Majáles</span>
    </h1>

    <div class="mt-8 md:mt-12 grid gap-10 lg:grid-cols-[1fr_1.1fr] lg:items-end">
      <div>
        <p class="display text-[clamp(3.5rem,11vw,7.5rem)] leading-none">{AKCE.datum}</p>
        <div class="mt-6 border-t-2 border-hot pt-5 grid grid-cols-2 gap-x-6 gap-y-1 text-base sm:text-lg font-medium">
          <p>{AKCE.den}<br />{AKCE.misto}<br />{AKCE.mesto}</p>
          <p>kapely · DJ · stánky<br />sport · zóny škol<br /><span class="font-bold">program brzy</span></p>
        </div>
        <div class="mt-8 flex flex-wrap gap-3">
          <a href="#program" class="tlacitko tlacitko-plne">Co tě čeká</a>
          <a href="/partneri/" class="tlacitko">Staň se partnerem</a>
        </div>
        <div class="mt-10">
          <p class="kicker mb-3">Do Majálesu zbývá</p>
          <Odpocet />
        </div>
      </div>

      <div class="relative w-full max-w-xl mx-auto aspect-[1/1.05] lg:aspect-auto lg:max-w-none lg:h-[36rem]">
        <figure class="absolute right-0 top-0 w-[86%] rotate-[2deg] rounded-[1.75rem] overflow-hidden ring-4 ring-hot">
          <Image
            src={hlavni.img}
            alt={hlavni.alt}
            widths={[480, 800, 1200]}
            sizes="(min-width: 1024px) 45vw, 86vw"
            loading="eager"
            fetchpriority="high"
            class="aspect-[4/3] w-full object-cover"
          />
        </figure>
        <figure class="absolute left-0 bottom-[6%] w-[52%] -rotate-[4deg] rounded-[1.5rem] overflow-hidden ring-4 ring-hot">
          <Image src={druha.img} alt={druha.alt} widths={[320, 560, 800]} sizes="(min-width: 1024px) 26vw, 52vw" class="aspect-[4/3] w-full object-cover" />
        </figure>
        <figure class="absolute right-[4%] bottom-0 w-[38%] rotate-[5deg] rounded-[1.25rem] overflow-hidden ring-4 ring-hot">
          <Image src={treti.img} alt={treti.alt} widths={[240, 420, 640]} sizes="(min-width: 1024px) 18vw, 38vw" class="aspect-square w-full object-cover" />
        </figure>
        <span class="absolute left-[2%] top-[8%] grid place-items-center size-24 sm:size-28 rounded-full bg-ruzova text-modra text-center -rotate-12 kicker !text-[0.7rem] leading-tight">
          Celé<br />náměstí<br />je naše
        </span>
      </div>
    </div>
  </div>
</section>
