---
import { Image, getImage } from 'astro:assets';
import { FOTKY } from '../data/fotky';

// role 'hero' / 'program:*' fotky jsou i v galerii – galerie je přehled všeho vybraného, nejnovější nahoře
const fotky = [...FOTKY].sort((a, b) => b.rok - a.rok);
const roky = [...new Set(fotky.map((f) => f.rok))];
const velke = await Promise.all(fotky.map((f) => getImage({ src: f.img, width: 1600, format: 'webp', quality: 78 })));
---

<div class="galerie">
  <div class="flex flex-wrap gap-2" role="group" aria-label="Filtrovat podle ročníku">
    <button type="button" class="filtr" aria-pressed="true" data-rok="vse">Všechny</button>
    {roky.map((r) => <button type="button" class="filtr" aria-pressed="false" data-rok={r}>{r}</button>)}
  </div>

  <!-- bez JavaScriptu CSS sloupce; skript je pak přeskládá a dorovná, ať všechny sloupce končí na stejné čáře -->
  <ul class="galerie-mriz mt-8 columns-2 md:columns-3 xl:columns-4 gap-3 sm:gap-4">
    {
      fotky.map((f, i) => (
        <li class="mb-3 sm:mb-4 break-inside-avoid" data-rok={f.rok}>
          <button
            type="button"
            class="group relative block w-full overflow-hidden rounded-2xl cursor-zoom-in"
            data-velka={velke[i].src}
            data-alt={f.alt}
            data-rok={f.rok}
            aria-label={`Zvětšit: ${f.alt} (${f.rok})`}
          >
            <Image
              src={f.img}
              alt={f.alt}
              widths={[360, 560, 800]}
              sizes="(min-width: 1280px) 22vw, (min-width: 768px) 31vw, 47vw"
              class="w-full h-auto transition-transform duration-500 group-hover:scale-[1.04]"
            />
            <span class="stitek absolute left-2 bottom-2 px-2.5 py-1 text-xs">
              {f.rok}
            </span>
          </button>
        </li>
      ))
    }
  </ul>

  <!-- touch-pan-y: vodorovný tah prstem si nebere prohlížeč, takže přepíná fotky -->
  <dialog class="lightbox m-auto max-w-none max-h-none w-full h-full na-modre p-0 backdrop:bg-modra touch-pan-y touch-pinch-zoom" aria-label="Fotka">
    <div class="relative grid h-full w-full place-items-center p-4 sm:p-10">
      <img class="max-h-[min(82vh,calc(100dvh-7rem))] max-w-full rounded-xl object-contain" alt="" />
      <p class="popis absolute bottom-4 left-1/2 -translate-x-1/2 w-[90%] text-center text-sm text-ruzova"></p>
      <button type="button" class="zavrit absolute right-3 top-3 sm:right-6 sm:top-6 lb-tl" aria-label="Zavřít">✕</button>
      <button type="button" class="pred absolute left-2 sm:left-6 top-1/2 -translate-y-1/2 lb-tl" aria-label="Předchozí">←</button>
      <button type="button" class="dalsi absolute right-2 sm:right-6 top-1/2 -translate-y-1/2 lb-tl" aria-label="Další">→</button>
    </div>
  </dialog>
</div>

<style>
  .filtr {
    min-height: 2.5rem;
    padding: 0.4rem 1.1rem;
    border-radius: 999px;
    font-weight: 700;
    border: 2px solid var(--text);
    color: var(--text);
    transition: background-color 0.15s, color 0.15s;
  }
  .filtr[aria-pressed='true'],
  .filtr:hover {
    background: var(--plne);
    border-color: var(--plne);
    color: var(--na-plnem);
  }
  .lb-tl {
    display: grid;
    place-items: center;
    width: 3rem;
    height: 3rem;
    border-radius: 999px;
    background: var(--color-modra);
    color: var(--color-ruzova);
    border: 2px solid var(--color-ruzova);
    font-size: 1.25rem;
    font-weight: 700;
  }
  .lb-tl:hover {
    background: var(--color-ruzova);
    color: var(--color-modra);
  }
  li[hidden] {
    display: none;
  }
  /* rozložení skriptem: fotky mají spočítanou polohu a výšku, ořez dorovná object-fit */
  .galerie-mriz.je-rozlozena {
    columns: auto;
    position: relative;
  }
  .galerie-mriz.je-rozlozena li {
    position: absolute;
    margin: 0;
  }
  .galerie-mriz.je-rozlozena button,
  .galerie-mriz.je-rozlozena img {
    height: 100%;
  }
  .galerie-mriz.je-rozlozena img {
    object-fit: cover;
  }
</style>

<script>
  const g = document.querySelector<HTMLElement>('.galerie');
  if (g) {
    const filtry = [...g.querySelectorAll<HTMLButtonElement>('.filtr')];
    const polozky = [...g.querySelectorAll<HTMLLIElement>('li[data-rok]')];
    const mriz = g.querySelector<HTMLElement>('.galerie-mriz')!;

    // Rozložení do sloupců se stejně vysokým koncem: fotka jde vždy do nejnižšího sloupce (nejnovější tak
    // zůstanou nahoře přes celou šířku) a výšky fotek ve sloupci se pak nepatrně natáhnou nebo zmáčknou
    // (ořez přes object-fit), aby všechny sloupce končily na stejné čáře.
    // Počet sloupců a mezery = třídy na <ul>: columns-2 md:columns-3 xl:columns-4, gap-3 sm:gap-4.
    const sloupcu = () => (matchMedia('(min-width: 1280px)').matches ? 4 : matchMedia('(min-width: 768px)').matches ? 3 : 2);
    const mezera = () => (matchMedia('(min-width: 640px)').matches ? 16 : 12);
    const rozlozit = () => {
      const v = polozky.filter((li) => !li.hidden);
      if (!v.length) return;
      // u filtru s pár fotkami aspoň dvě fotky na sloupec
      const n = Math.min(sloupcu(), v.length, Math.max(2, Math.floor(v.length / 2)));
      const m = mezera();
      const s = (mriz.clientWidth - m * (n - 1)) / n;
      const sloupce = Array.from({ length: n }, () => ({ vyska: 0, fotky: [] as { li: HTMLLIElement; h: number }[] }));
      for (const li of v) {
        const im = li.querySelector('img');
        const pomer = Number(im?.getAttribute('height')) / Number(im?.getAttribute('width')) || 0.75;
        const c = sloupce.reduce((a, b) => (b.vyska < a.vyska ? b : a));
        c.fotky.push({ li, h: s * pomer });
        c.vyska += s * pomer + m;
      }
      // cíl = průměrná výška sloupce; natažení/zmáčknutí je omezené, ať se fotky moc neořežou
      const cil = sloupce.reduce((a, c) => a + c.vyska - m, 0) / n;
      let nejvys = 0;
      sloupce.forEach((c, i) => {
        const fotky = c.fotky.reduce((a, f) => a + f.h, 0);
        const k = Math.min(1.35, Math.max(0.75, (cil - m * (c.fotky.length - 1)) / fotky));
        let y = 0;
        for (const f of c.fotky) {
          const nahore = Math.round(y);
          y += f.h * k;
          Object.assign(f.li.style, { left: `${i * (s + m)}px`, top: `${nahore}px`, width: `${s}px`, height: `${Math.round(y) - nahore}px` });
          y += m;
        }
        nejvys = Math.max(nejvys, Math.round(y - m));
      });
      mriz.style.height = `${nejvys}px`;
    };
    mriz.classList.add('je-rozlozena');
    rozlozit();
    // znovu rozložit jen při změně šířky (výšku mění rozlozit sám)
    let sirka = mriz.clientWidth;
    let cekam = 0;
    new ResizeObserver(() => {
      if (mriz.clientWidth === sirka) return;
      sirka = mriz.clientWidth;
      cancelAnimationFrame(cekam);
      cekam = requestAnimationFrame(rozlozit);
    }).observe(mriz);

    filtry.forEach((b) =>
      b.addEventListener('click', () => {
        filtry.forEach((x) => x.setAttribute('aria-pressed', String(x === b)));
        polozky.forEach((li) => (li.hidden = b.dataset.rok !== 'vse' && li.dataset.rok !== b.dataset.rok));
        rozlozit();
      }),
    );

    const dlg = g.querySelector<HTMLDialogElement>('dialog')!;
    const img = dlg.querySelector('img')!;
    const popis = dlg.querySelector<HTMLElement>('.popis')!;
    let aktualni = 0;
    const viditelne = () => polozky.filter((li) => !li.hidden).map((li) => li.querySelector<HTMLButtonElement>('button')!);
    const ukaz = (i: number) => {
      const v = viditelne();
      aktualni = (i + v.length) % v.length;
      const b = v[aktualni];
      img.src = b.dataset.velka!;
      img.alt = b.dataset.alt!;
      // rok jen tehdy, když už není v popisu fotky
      popis.textContent = b.dataset.alt!.includes(b.dataset.rok!) ? b.dataset.alt! : `${b.dataset.alt} · ${b.dataset.rok}`;
    };
    polozky.forEach((li) =>
      li.querySelector('button')!.addEventListener('click', (e) => {
        ukaz(viditelne().indexOf(e.currentTarget as HTMLButtonElement));
        dlg.showModal();
      }),
    );
    dlg.querySelector('.zavrit')!.addEventListener('click', () => dlg.close());
    dlg.querySelector('.pred')!.addEventListener('click', () => ukaz(aktualni - 1));
    dlg.querySelector('.dalsi')!.addEventListener('click', () => ukaz(aktualni + 1));
    dlg.addEventListener('click', (e) => e.target === dlg.firstElementChild && dlg.close());
    dlg.addEventListener('keydown', (e) => {
      if (e.key === 'ArrowLeft') ukaz(aktualni - 1);
      if (e.key === 'ArrowRight') ukaz(aktualni + 1);
    });
    // swipe na telefonu
    let x0: number | null = null;
    dlg.addEventListener('pointerdown', (e) => (x0 = e.clientX));
    dlg.addEventListener('pointerup', (e) => {
      if (x0 !== null && Math.abs(e.clientX - x0) > 50) ukaz(aktualni + (e.clientX < x0 ? 1 : -1));
      x0 = null;
    });
  }
</script>
