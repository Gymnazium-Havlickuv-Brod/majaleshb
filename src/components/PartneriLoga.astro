---
import { Image } from 'astro:assets';
import { PARTNERI, MISTA, type UrovenLoga } from '../data/partneri';

interface Props {
  nadpis?: string;
  nadpisPrazdne?: string;
  kicker?: string;
  odkazNaNabidku?: boolean;
}
const {
  nadpis: nadpisPotvrzeni = 'Děkujeme partnerům',
  nadpisPrazdne = 'Tady může být vaše logo',
  kicker = 'Partneři Majálesu 2027',
  odkazNaNabidku = true,
} = Astro.props;
// dokud nikdo není potvrzený, neděkujeme prázdným místům
const nadpis = PARTNERI.length ? nadpisPotvrzeni : nadpisPrazdne;

const loga = import.meta.glob<{ default: ImageMetadata }>('../assets/partneri/*.{svg,png,jpg,jpeg,webp}', { eager: true });
const logo = (soubor?: string) => (soubor ? loga[`../assets/partneri/${soubor}`]?.default : undefined);

const urovne = (Object.keys(MISTA) as UrovenLoga[]).map((u) => {
  const potvrzeni = PARTNERI.filter((p) => p.uroven === u);
  return { u, ...MISTA[u], potvrzeni, volna: Math.max(0, MISTA[u].pocet - potvrzeni.length) };
});

// velikost karet podle úrovně
const mrizka: Record<UrovenLoga, string> = {
  hlavni: 'grid-cols-2 sm:grid-cols-3',
  partner: 'grid-cols-2 sm:grid-cols-3 lg:grid-cols-4',
};
const vyska: Record<UrovenLoga, string> = {
  hlavni: 'h-28 sm:h-32',
  partner: 'h-24',
};
const logoVyska: Record<UrovenLoga, string> = {
  hlavni: 'max-h-14 sm:max-h-16',
  partner: 'max-h-12',
};
---

<div class="partneri-loga">
  <div class="flex flex-wrap items-end justify-between gap-4">
    <div>
      <p class="kicker">{kicker}</p>
      <h2 class="display mt-3 text-[clamp(2.5rem,7vw,4.5rem)]">{nadpis}</h2>
    </div>
    {
      odkazNaNabidku && (
        <a href="/partneri/" class="odkaz">
          Chcete tu být taky? <span class="text-hot" aria-hidden="true">→</span>
        </a>
      )
    }
  </div>

  <div class="mt-10 space-y-10">
    {
      urovne.map((ur) => (
        <div>
          <h3 class="kicker !text-[0.7rem] mb-4">{ur.nadpis}</h3>
          <ul class:list={['grid gap-3 sm:gap-4', mrizka[ur.u]]}>
            {ur.potvrzeni.map((p) => {
              const img = logo(p.logo);
              const obsah = img ? (
                <Image src={img} alt={p.nazev} class:list={['w-auto max-w-[80%] object-contain', logoVyska[ur.u]]} />
              ) : (
                <span class="display text-modra text-2xl text-center px-4">{p.nazev}</span>
              );
              return (
                <li>
                  {p.url ? (
                    <a href={p.url} rel="noopener" target="_blank" class:list={['grid place-items-center rounded-[1.25rem] karta hover:border-modra transition-colors', vyska[ur.u]]}>
                      {obsah}
                    </a>
                  ) : (
                    <div class:list={['grid place-items-center rounded-[1.25rem] karta', vyska[ur.u]]}>{obsah}</div>
                  )}
                </li>
              );
            })}
            {Array.from({ length: ur.volna }).map((_, i) => (
              // na mobilu stačí méně zástupných míst
              <li class:list={{ 'hidden sm:block': ur.u === 'partner' && ur.potvrzeni.length + i >= 4 }}>
                <a
                  href="/partneri/"
                  class:list={[
                    'group grid place-items-center rounded-[1.25rem] border-2 border-dashed border-hot hover:border-solid',
                    vyska[ur.u],
                  ]}
                  aria-label={`Volné místo: ${ur.nadpis.toLowerCase()}. Zobrazit nabídku partnerství.`}
                >
                  <span class="text-center">
                    <span class:list={['display block leading-none', ur.u === 'hlavni' ? 'text-3xl sm:text-4xl' : 'text-2xl']}>Vaše logo</span>
                  </span>
                </a>
              </li>
            ))}
          </ul>
        </div>
      ))
    }
  </div>
</div>
