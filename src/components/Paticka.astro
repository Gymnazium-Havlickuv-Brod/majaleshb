---
import { AKCE, KONTAKT } from '../data/akce';
const site = [
  KONTAKT.instagram && { href: KONTAKT.instagram, text: 'Instagram' },
  KONTAKT.facebook && { href: KONTAKT.facebook, text: 'Facebook' },
].filter(Boolean) as { href: string; text: string }[];
---

<footer class="na-modre">
  <div class="obal py-14 grid gap-10 md:grid-cols-[1.4fr_1fr_1fr]">
    <div>
      <p class="display text-[clamp(3rem,10vw,6rem)]">Majáles<br />{AKCE.rok}</p>
      <p class="mt-4 max-w-sm">
        Studentský Majáles v Havlíčkově Brodě. Pořádají {AKCE.skoly.join(' a ')} {AKCE.spoluprace}.
      </p>
    </div>
    <div>
      <p class="kicker">Kdy a kde</p>
      <p class="mt-3 leading-relaxed">
        {AKCE.den} {AKCE.datum}<br />
        {AKCE.misto}<br />
        {AKCE.mesto}
      </p>
    </div>
    <div>
      <p class="kicker">Kontakt</p>
      <ul class="mt-3 space-y-2">
        <li><a class="odkaz" href={`mailto:${KONTAKT.email}`}>{KONTAKT.email}</a></li>
        {site.map((s) => <li><a class="odkaz" href={s.href} rel="noopener">{s.text}</a></li>)}
        <li><a class="odkaz" href="/partneri/">Pro partnery</a></li>
      </ul>
    </div>
  </div>
  <div class="obal pb-8 text-sm flex flex-wrap justify-between gap-2">
    <span>© {AKCE.rok} Majáles HB</span>
    <span>Fotky: archiv Majálesu 2017–2026</span>
  </div>
</footer>
